-- Mobile-only Roblox touch-control visibility settings.
if UserInputService.TouchEnabled then
    local function getTouchControlFrame()
        local player = Players.LocalPlayer
        local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
        local touchGui = playerGui and playerGui:FindFirstChild("TouchGui")
        return touchGui and touchGui:FindFirstChild("TouchControlFrame")
    end

    local hideJoystick = false
    local hideJumpButton = false

    local function applyMobileControlVisibility()
        local touchControlFrame = getTouchControlFrame()
        if not touchControlFrame then return end

        local thumbstick = touchControlFrame:FindFirstChild("DynamicThumbstickFrame")
        if thumbstick then
            thumbstick.Visible = not hideJoystick
        end

        local jumpButton = touchControlFrame:FindFirstChild("JumpButton")
        if jumpButton and jumpButton:IsA("ImageButton") then
            jumpButton.ImageTransparency = hideJumpButton and 1 or 0
        end
    end

    createModule("Hide Joystick", false, true, function(isOn)
        hideJoystick = isOn
        applyMobileControlVisibility()
    end).Parent = SettingsScroll

    createModule("Hide Jump Button", false, true, function(isOn)
        hideJumpButton = isOn
        applyMobileControlVisibility()
    end).Parent = SettingsScroll

    -- TouchGui can be recreated after respawning; reapply the selected states.
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    playerGui.ChildAdded:Connect(function(child)
        if child.Name == "TouchGui" then
            task.defer(applyMobileControlVisibility)
        end
    end)
end

