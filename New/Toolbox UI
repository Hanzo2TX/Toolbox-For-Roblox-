-- Responsive scale keeps the UI visually consistent across phones, tablets and desktop.
local ResponsiveScale = Instance.new("UIScale", MobileOverlay)
ResponsiveScale.Name = "ResponsiveScale"

local function updateResponsiveScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local vp = camera.ViewportSize
    -- 1280x720 is the design reference. Scale down on smaller screens, while
    -- avoiding oversized UI on large tablets/desktop displays.
    local scale = math.min(vp.X / 1280, vp.Y / 720)
    ResponsiveScale.Scale = math.clamp(scale, 0.72, 1)
end

updateResponsiveScale()

