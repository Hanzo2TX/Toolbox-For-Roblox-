local RunningFeatures = {}

local function compileAndRun(code, label, key, async)
    if type(code) ~= "string" or code:gsub("%s", "") == "" then
        warn("[ToolBox] No implementation found for " .. tostring(label))
        return false
    end

    key = key or label
    if RunningFeatures[key] then
        return false
    end

    local compiler = loadstring or load
    if not compiler then
        warn("[ToolBox] loadstring/load is unavailable in this executor")
        return false
    end

    local fn, err = compiler(code)
    if not fn then
        warn("[ToolBox] Failed to compile " .. tostring(label) .. ": " .. tostring(err))
        return false
    end

    RunningFeatures[key] = true

    local function execute()
        local ok, execErr = pcall(fn)
        RunningFeatures[key] = nil
        if not ok then
            warn("[ToolBox] Failed to run " .. tostring(label) .. ": " .. tostring(execErr))
        end
    end

    if async then
        task.spawn(execute)
    else
        execute()
    end

    return true
end

local function BuildCategoryFromData(data)
    local catObj = Toolbox:Category(data.name)

    local function runItem(item, value)
        if MenuUnloaded then return end

        if type(item.callback) == "function" then
            local ok, err = pcall(item.callback, value)
            if not ok then
                warn("[ToolBox] " .. tostring(item.label) .. " failed: " .. tostring(err))
            end
            return
        end

        local code = item.action_code or item.function_code
        if type(code) == "string" and code:gsub("%s", "") ~= "" then
            compileAndRun(code, item.label, item.path, item.async == true or item.label == "Auto Quick Time")
        end
    end

    local function addItem(parentApi, item)
        if type(item) ~= "table" then return end
        local itemType = string.lower(tostring(item.type or ""))

        if itemType == "action" or itemType == "button" or itemType == "normal_button" or itemType == "text_button" then
            local runAction = function()
                if item.label == "Unload Menu" then
                    unloadMenu()
                    return
                end
                runItem(item)
            end

            parentApi:TextButton(item.label or "Button", runAction)

            if item.has_shortcut and item.path then
                _G.ModuleRegistry[item.path] = {
                    toggleFunc = runAction,
                    isOn = false,
                    updateShortcut = function() end,
                    label = item.label,
                    icon = item.icon or data.icon or "rbxassetid://0",
                    isAction = true
                }
            end

        elseif itemType == "one_time_action" or itemType == "one_time_button" or itemType == "onetime" then
            parentApi:OneTimeButton(item.label or "Button", function()
                runItem(item)
            end)

        elseif itemType == "toggle" then
            local modApi, toggleFunc = parentApi:ModuleSettingDropdown(item.label or "Toggle", item.enabled == true, function(isOn)
                if item.label == "FullBright" or item.label == "Fullbright + NoFog" then
                    setFullbright(isOn)
                elseif item.label == "Noclip" then
                    setNoclip(isOn)
                end

                runItem(item, isOn)

                if item.path then
                    local reg = _G.ModuleRegistry[item.path]
                    if reg then
                        reg.isOn = isOn
                        reg.updateShortcut(isOn)
                    end
                end
            end)

            if item.has_shortcut and item.path then
                _G.ModuleRegistry[item.path] = {
                    api = modApi,
                    toggleFunc = toggleFunc,
                    isOn = item.enabled == true,
                    updateShortcut = function() end,
                    label = item.label,
                    icon = item.icon or data.icon or "rbxassetid://0",
                    isAction = false
                }
            end

            for _, sub in ipairs(item.items or {}) do
                addItem(modApi, sub)
            end

        elseif itemType == "divider" or itemType == "section" then
            local divApi = parentApi:Divider(item.label or item.name or "Section")
            for _, sub in ipairs(item.items or {}) do
                addItem(divApi, sub)
            end

        elseif itemType == "slider" then
            local min = item.min or (item.range and item.range[1]) or 0
            local max = item.max or (item.range and item.range[2]) or 100
            local value = item.value
            if value == nil then value = min end
            parentApi:Slider(item.label or "Slider", min, max, value, item.step or 1, function(v)
                runItem(item, v)
            end)

        elseif itemType == "checkbox" then
            parentApi:Checkbox(item.label or "Checkbox", item.enabled == true or item.value == true, function(v)
                runItem(item, v)
            end)

        elseif itemType == "select" or itemType == "dropdown" then
            parentApi:Select(item.label or "Select", item.options or {}, function(v)
                runItem(item, v)
            end)

        elseif itemType == "multiselect" or itemType == "multi_select" or itemType == "multiple_select" then
            parentApi:MultiSelect(item.label or "Multi Select", item.options or {}, function(v)
                runItem(item, v)
            end)

        elseif itemType == "player_list" then
            local divApi = parentApi:Divider(item.label or "Player")
            local function getPlayers()
                local names = {}
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LocalPlayer then table.insert(names, pl.Name) end
                end
                return names
            end
            local _, updateDropdown, getSelectedTarget = divApi:Select("Target Player", getPlayers())
            Players.PlayerAdded:Connect(function() task.defer(function() updateDropdown(getPlayers()) end) end)
            Players.PlayerRemoving:Connect(function() task.defer(function() updateDropdown(getPlayers()) end) end)
            divApi:TextButton("Confirm Teleport", function()
                local targetName = getSelectedTarget()
                local target = targetName and Players:FindFirstChild(targetName)
                local myCharacter = LocalPlayer.Character
                local targetCharacter = target and target.Character
                local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                if myRoot and targetRoot then
                    myCharacter:PivotTo(targetRoot.CFrame + Vector3.new(0, 3, 0))
                end
            end)
        end
    end

    for _, item in ipairs(data.items or {}) do
        addItem(catObj, item)
    end
    return catObj
end

-- Public registration API for external game feature packs.
-- Categories registered after startup are inserted before the built-in Hall of Fame.
local function ReindexToolboxCategories()
    for i, categoryData in ipairs(Toolbox.Categories) do
        categoryData.Index = i
        if categoryData.Button then
            categoryData.Button.LayoutOrder = i
        end
    end
end

function Toolbox:RegisterCategories(categories)
    if type(categories) ~= "table" then return self end

    for _, categoryDefinition in ipairs(categories) do
        if type(categoryDefinition) == "table" and categoryDefinition.name then
            local beforeCount = #self.Categories
            BuildCategoryFromData(categoryDefinition)
            local newCategory = self.Categories[beforeCount + 1]

            if newCategory then
                local hallIndex
                for i, existing in ipairs(self.Categories) do
                    if existing ~= newCategory and existing.Name == "Hall of Fame" then
                        hallIndex = i
                        break
                    end
                end

                if hallIndex then
                    table.remove(self.Categories, beforeCount + 1)
                    table.insert(self.Categories, hallIndex, newCategory)
                end
            end
        end
    end

    ReindexToolboxCategories()
    RefreshPortraitFeatures()

    if not self.ActiveCategory and self.Categories[1] then
        ActivateCategoryByIndex(1)
    end

    return self
end

function Toolbox:RegisterCategory(categoryDefinition)
    return self:RegisterCategories({categoryDefinition})
end

