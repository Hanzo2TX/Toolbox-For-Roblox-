local function landscapeTweenEntries(isClosing)
    local function target(pos)
        if isClosing then
            return UDim2.new(-1, pos.X.Offset, pos.Y.Scale, pos.Y.Offset)
        end
        return pos
    end
    return {
        {MainPlate,    {Position = target(PosCache.Main)}},
        {LinkPlate,    {Position = target(PosCache.Link)}},
        {CatListPlate, {Position = target(PosCache.Cat)}},
        {ModulePlate,  {Position = target(PosCache.Mod)}},
        {LogoPlate,    {Position = target(PosCache.Logo)}},
        {MinPlate,     {Position = target(PosCache.Min)}},
    }
end

