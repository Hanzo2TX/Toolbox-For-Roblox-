        P_CategoryPages[i] = page

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            page.CanvasSize = UDim2.new(0, 0, 0, h)
            page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
        end)
        page:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            page.CanvasSize = UDim2.new(0, 0, 0, h)
            page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
        end)
        page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            if page.CanvasPosition.X ~= 0 or page.CanvasPosition.Y < 0 or page.CanvasPosition.Y > maxY then
                page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
            end
        end)
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset)
    end

    updatePortraitCatScroll()
    P_selectCategory(1)
end

