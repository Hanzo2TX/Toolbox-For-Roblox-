local function updateSpacer()
    local containerH = CategoryScroll.AbsoluteWindowSize.Y
    if containerH == 0 then return end
    
    local usedHeight = 0
    local childCount = 0
    
    for _, child in ipairs(CategoryScroll:GetChildren()) do
        if child:IsA("GuiObject") and child.Visible and child ~= ShortcutSpacer and child ~= ShortcutsButton then
            usedHeight = usedHeight + child.Size.Y.Offset
            childCount = childCount + 1
        end
    end
    
    usedHeight = usedHeight + (math.max(0, childCount) * 5) 
    
    local footerH = 45 + 10 
    
    local available = containerH - usedHeight - footerH
    
    local finalSpacerHeight = math.max(0, available) 
    
    ShortcutSpacer.Size = UDim2.new(1, 0, 0, finalSpacerHeight)
end

local function updateScroll(frame, layout, padding)
    local h = layout.AbsoluteContentSize.Y + padding.PaddingTop.Offset + padding.PaddingBottom.Offset
    frame.CanvasSize = UDim2.new(0, 0, 0, h)
    local max = h - frame.AbsoluteWindowSize.Y
    if max < 0 then max = 0 end
    frame.CanvasPosition = Vector2.new(0, math.clamp(frame.CanvasPosition.Y, 0, max))
end

