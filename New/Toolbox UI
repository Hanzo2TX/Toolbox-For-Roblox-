    local function clampToViewport(x, y)
        local camera = workspace.CurrentCamera
        local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
        local size = btn.AbsoluteSize
        local margin = 4
        return math.clamp(x, margin, math.max(margin, vp.X - size.X - margin)),
               math.clamp(y, margin, math.max(margin, vp.Y - size.Y - margin))
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        activeInput = input
        moved = false
        dragStart = input.Position
        startAbs = btn.AbsolutePosition
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or not dragStart or not startAbs then return end

        local isMouseDrag = activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        local isTouchDrag = activeInput and activeInput.UserInputType == Enum.UserInputType.Touch
            and input == activeInput
        if not isMouseDrag and not isTouchDrag then return end

        local delta = input.Position - dragStart
        if not moved and delta.Magnitude >= DRAG_THRESHOLD then
            moved = true
        end
        if not moved then return end

        local x, y = clampToViewport(startAbs.X + delta.X, startAbs.Y + delta.Y)
        btn.AnchorPoint = Vector2.new(0, 0)
        btn.Position = UDim2.fromOffset(x, y)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging or not activeInput then return end
        local matchesMouse = activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1
        local matchesTouch = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
        if not matchesMouse and not matchesTouch then return end

        dragging = false
        activeInput = nil
        dragStart = nil
        startAbs = nil

        if moved then
            -- Roblox can emit Activated immediately after InputEnded. Block that release.
            suppressUntil = os.clock() + 0.15
            moved = false
            return
        end

        if os.clock() >= suppressUntil and onClick then
            onClick()
        end
    end)
end

local function applyOrientation()
    local portrait = isPortrait()
    local newOrientation = portrait and "portrait" or "landscape"
    if newOrientation == CurrentOrientation then return end
    CurrentOrientation = newOrientation

    if portrait then
        isMin = false
        if _G._LandscapeReset then _G._LandscapeReset() end
        if Restore then Restore.Visible = false end
    else
        P_isMin = false
        if _G._PortraitReset then _G._PortraitReset() end
        if P_Restore then P_Restore.Visible = false end
    end

    for _, elem in ipairs(LandscapeElements) do
        if elem and elem.Parent then elem.Visible = not portrait end
    end
    for _, elem in ipairs(PortraitElements) do
        if elem and elem.Parent then elem.Visible = portrait end
    end
end

