        if category and category.Select then
            return category:Select(label, options or {}, callback)
        elseif category and category.Divider then
            local divider = category:Divider(label)
            return divider:Select(label, options or {}, callback)
        end
    end,
    AddSelect = function(category, label, options, callback)
        if category and category.Select then
            return category:Select(label, options or {}, callback)
        end
    end,
    AddMultiSelect = function(category, label, options, callback)
        if category and category.MultiSelect then
            return category:MultiSelect(label, options or {}, callback)
        elseif category and category.Divider then
            local divider = category:Divider(label)
            return divider:MultiSelect(label, options or {}, callback)
        end
    end,
    Refresh = function()
        ReindexToolboxCategories()
        RefreshPortraitFeatures()
    end
}

