    selLab.TextColor3 = Color3.fromRGB(200, 200, 200)
    selLab.TextXAlignment = Enum.TextXAlignment.Right
    selLab.Font = mainFont
    selLab.TextSize = 16
    selLab.ZIndex = 6

    local optFrame = Instance.new("Frame", frame)
    optFrame.Name = "OptionsFrame"
    optFrame.Size = UDim2.new(1, 0, 0, 0)
    optFrame.BackgroundTransparency = 1
    optFrame.ClipsDescendants = true
    optFrame.ZIndex = 5
    optFrame.LayoutOrder = 2
    local oList = Instance.new("UIListLayout", optFrame)
    oList.Padding = UDim.new(0, PADDING)
    local oPad = Instance.new("UIPadding", optFrame)
    oPad.PaddingLeft = UDim.new(0.05, 0)
    oPad.PaddingRight = UDim.new(0.05, 0)
    oPad.PaddingTop = UDim.new(0, PADDING)
    oPad.PaddingBottom = UDim.new(0, PADDING)

    local isOpen = false
    local selectedMap = {}
    if options[1] then selectedMap[options[1]] = true end
    local buttons = {}
    local cloneSyncCallbacks = {}
    local cloneRefreshCallbacks = {}

    local function getSelectedOptions()
        local chosen = {}
        for _, opt in ipairs(options) do
            if selectedMap[opt] then
                table.insert(chosen, opt)
            end
        end
        return chosen
    end

    local function syncPortraitClones()
        for i = #cloneSyncCallbacks, 1, -1 do
            local cb = cloneSyncCallbacks[i]
            local ok = pcall(cb)
            if not ok then
                table.remove(cloneSyncCallbacks, i)
            end
        end
    end

    local function updateOptionVisuals()
        for opt, btn in pairs(buttons) do
            if btn and btn.Parent then
                if selectedMap[opt] then
                    btn.TextColor3 = SELECTED_TEXT_COLOR
                    RegisterRGB(btn, "Text", SELECTED_TEXT_COLOR)
                else
                    btn.TextColor3 = WHITE
                    UnregisterRGB(btn, "Text")
                end
            end
        end
        syncPortraitClones()
    end

    local function updateParent()
        task.wait()
        if getIsOpen() then
             local l = settingsContainer:FindFirstChildOfClass("UIListLayout")
             local p = settingsContainer:FindFirstChild("UIPadding")
             if l and p then
                local h = l.AbsoluteContentSize.Y + p.PaddingTop.Offset + p.PaddingBottom.Offset
                TweenService:Create(settingsContainer, TweenInfo.new(getAnimSpeed()), {Size = UDim2.new(1, 0, 0, h)}):Play()
                local head = settingsContainer.Parent:FindFirstChild("HeaderBar")
                if head then TweenService:Create(settingsIndicator, TweenInfo.new(getAnimSpeed()), {Size = UDim2.new(0, 2, 0, head.AbsoluteSize.Y + h - 10)}):Play() end
             end
        end
    end

    local function setOpen(newOpen)
        isOpen = newOpen and true or false
        local h = 0
        if isOpen and #options > 0 then
            h = (#options * OPTION_HEIGHT) + (#options * (PADDING - 1)) + oPad.PaddingTop.Offset + oPad.PaddingBottom.Offset
        end
        optFrame.Size = UDim2.new(1, 0, 0, h)
        updateParent()
        syncPortraitClones()
    end

    local function selectOption(opt)
        if isMultiSelect then
            selectedMap[opt] = not selectedMap[opt]
            updateOptionVisuals()
            local c = {}
            for _, o in ipairs(options) do if selectedMap[o] then table.insert(c, o) end end
            selLab.Text = #c > 0 and table.concat(c, ", ") or "None"
        else
            for _, o in ipairs(options) do
                selectedMap[o] = false
            end
            selectedMap[opt] = true
            updateOptionVisuals()
            selLab.Text = opt
            setOpen(false)
        end

        if callback then
            local selected = getSelectedOptions()
            if isMultiSelect then
                pcall(callback, selected)
            else
                pcall(callback, selected[1])
            end
        end
    end

    local function refreshOptions(newOptions)
        for _, c in ipairs(optFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        buttons = {}
        options = newOptions or {}

        local previousSelection
        for _, opt in ipairs(options) do
            if selectedMap[opt] then
                previousSelection = opt
                break
            end
        end

        selectedMap = {}
        if isMultiSelect then
            for _, opt in ipairs(options) do
                if opt == previousSelection then
                    selectedMap[opt] = true
                end
            end
        elseif previousSelection then
            selectedMap[previousSelection] = true
        elseif options[1] then
            selectedMap[options[1]] = true
        end

        for _, opt in ipairs(options) do
            local btn = Instance.new("TextButton", optFrame)
            btn.Size = UDim2.new(1, 0, 0, 35)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.BackgroundTransparency = 0
            btn.Text = "  " .. opt
            btn.TextColor3 = WHITE
            btn.Font = mainFont
            btn.TextSize = 16
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.ZIndex = 6
            applyCorner(btn)
            buttons[opt] = btn

            bindPress(btn, function()
                selectOption(opt)
            end)
        end

        if isMultiSelect then
            local c = {}
            for _, o in ipairs(options) do if selectedMap[o] then table.insert(c, o) end end
            selLab.Text = #c > 0 and table.concat(c, ", ") or "None"
        else
            selLab.Text = previousSelection or options[1] or "None"
        end

        updateOptionVisuals()
        for i = #cloneRefreshCallbacks, 1, -1 do
            local cb = cloneRefreshCallbacks[i]
            local ok = pcall(cb, options)
            if not ok then
                table.remove(cloneRefreshCallbacks, i)
            end
        end
        syncPortraitClones()
    end

    refreshOptions(options)

    bindPress(bar, function()
        setOpen(not isOpen)
    end)

    _G.PortraitControllers[frame] = {
        getValue = function()
            local selected = getSelectedOptions()
            if isMultiSelect then
                return selected
            end
            return selected[1]
        end,
        bindClone = function(clone)
            local cloneBar = clone:FindFirstChildOfClass("TextButton")
            local function syncCloneVisuals(cloneOptionsFrame, srcButtons, cloneButtons)
                for i, cbtn in ipairs(cloneButtons) do
                    local sbtn = srcButtons[i]
                    if sbtn and cbtn then
                        cbtn.Text = sbtn.Text
                        cbtn.TextColor3 = sbtn.TextColor3
                        cbtn.BackgroundColor3 = sbtn.BackgroundColor3
                        cbtn.BackgroundTransparency = sbtn.BackgroundTransparency
                    end
                end
            end

            local function ensureCloneButtons(cloneOptionsFrame)
                if not cloneOptionsFrame then return {}, {} end
                local srcButtons, cloneButtons = {}, {}
                for _, child in ipairs(optFrame:GetChildren()) do
                    if child:IsA("TextButton") then
                        table.insert(srcButtons, child)
                    end
                end
                for _, child in ipairs(cloneOptionsFrame:GetChildren()) do
                    if child:IsA("TextButton") then
                        table.insert(cloneButtons, child)
                    end
                end

                while #cloneButtons > #srcButtons do
                    local btn = table.remove(cloneButtons)
                    if btn then btn:Destroy() end
                end

                for i = #cloneButtons + 1, #srcButtons do
                    local newBtn = srcButtons[i]:Clone()
                    newBtn.Parent = cloneOptionsFrame
                    table.insert(cloneButtons, newBtn)
                end

                cloneButtons = {}
                for _, child in ipairs(cloneOptionsFrame:GetChildren()) do
                    if child:IsA("TextButton") then
                        table.insert(cloneButtons, child)
                    end
                end

                return srcButtons, cloneButtons
            end

            local function wireOptionButtons()
                local cloneOptionsFrame = clone:FindFirstChild("OptionsFrame", true)
                if not cloneOptionsFrame then return end
                local srcButtons, cloneButtons = ensureCloneButtons(cloneOptionsFrame)
                syncCloneVisuals(cloneOptionsFrame, srcButtons, cloneButtons)
                for i, cbtn in ipairs(cloneButtons) do
                    local sbtn = srcButtons[i]
                    if sbtn then
                        bindPress(cbtn, function()
                            local opt = string.gsub(sbtn.Text or "", "^%s+", "")
                            if opt ~= "" then
                                selectOption(opt)
                                syncCloneVisuals(cloneOptionsFrame, srcButtons, cloneButtons)
                            end
                        end)
                    end
                end
            end

            local function syncThisClone()
                local cloneOptionsFrame = clone:FindFirstChild("OptionsFrame", true)
                local cloneSelLab = clone:FindFirstChild("SelectedLabel", true)
                if cloneSelLab then
                    cloneSelLab.Text = selLab.Text
                end
                if cloneOptionsFrame then
                    cloneOptionsFrame.Size = optFrame.Size
                    local srcButtons, cloneButtons = ensureCloneButtons(cloneOptionsFrame)
                    syncCloneVisuals(cloneOptionsFrame, srcButtons, cloneButtons)
                end
            end

            if cloneBar then
                bindPress(cloneBar, function()
                    setOpen(not isOpen)
                    wireOptionButtons()
                end)
            end

            table.insert(cloneSyncCallbacks, syncThisClone)
            table.insert(cloneRefreshCallbacks, function()
                wireOptionButtons()
                syncThisClone()
            end)

            wireOptionButtons()
            syncThisClone()
            optFrame.ChildAdded:Connect(function()
                wireOptionButtons()
                syncThisClone()
            end)
            optFrame.ChildRemoved:Connect(function()
                wireOptionButtons()
                syncThisClone()
            end)
        end
    }

    return frame, refreshOptions, function()
        local selected = getSelectedOptions()
        if isMultiSelect then
            return selected
        end
        return selected[1]
    end
end

