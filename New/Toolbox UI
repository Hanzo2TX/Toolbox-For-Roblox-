-- Keep UI image assets using Roblox's smooth/default resampling and preload them.
-- This cannot override Roblox's device-level texture-quality limits, but it avoids
-- extra blur caused by accidental pixelated resampling and late image loading.
local ContentProvider = game:GetService("ContentProvider")

local function optimizeUIImage(object)
    if not (object:IsA("ImageLabel") or object:IsA("ImageButton")) then
        return
    end

    pcall(function()
        object.ResampleMode = Enum.ResamplerMode.Default
    end)
end

local function optimizeAllUIImages()
    local images = {}

    for _, object in ipairs(ToolboxGui:GetDescendants()) do
        if object:IsA("ImageLabel") or object:IsA("ImageButton") then
            optimizeUIImage(object)
            table.insert(images, object)
        end
    end

    if #images > 0 then
        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync(images)
            end)
        end)
    end
end

ToolboxGui.DescendantAdded:Connect(function(object)
    if object:IsA("ImageLabel") or object:IsA("ImageButton") then
        optimizeUIImage(object)

        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({object})
            end)
        end)
    end
end)

optimizeAllUIImages()
