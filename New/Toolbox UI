local _portraitRefreshQueued = false
local function RefreshPortraitFeatures()
    if _portraitRefreshQueued then return end
    _portraitRefreshQueued = true
    task.defer(function()
        _portraitRefreshQueued = false
        local wanted = P_ActiveCatIndex or 1
        BuildPortraitCategoryTabs()
        if #P_CategoryPages > 0 then
            P_selectCategory(math.clamp(wanted, 1, #P_CategoryPages), true)
        end
    end)
end


local P_AllPanels = {P_TitleBar, P_MinBar, P_Frame2, P_Frame3}

local function playTweenGroup(entries, info)
    local tweens = {}
    for _, entry in ipairs(entries) do
        tweens[#tweens + 1] = TweenService:Create(entry[1], info, entry[2])
    end
    -- Build every tween first, then start them in the same frame.
    for _, tween in ipairs(tweens) do tween:Play() end
    return tweens
end

local function portraitSlideOut()
    local dur = getAnimSpeed()
    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local entries = {}
    for _, plate in ipairs(P_AllPanels) do
        entries[#entries + 1] = {plate, {Position = UDim2.new(-1, 0, plate.Position.Y.Scale, plate.Position.Y.Offset)}}
    end
    playTweenGroup(entries, info)
    closePortraitSettings()
    task.delay(dur, function()
        if P_isMin then P_Restore.Visible = true end
    end)
end

local function portraitSlideIn()
    local dur = getAnimSpeed()
    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    playTweenGroup({
        {P_TitleBar, {Position = P_POS.TitleBar}},
        {P_MinBar,   {Position = P_POS.MinBar}},
        {P_Frame2,   {Position = P_POS.Frame2}},
        {P_Frame3,   {Position = P_POS.Frame3}},
    }, info)
end

