local NoclipSavedCollision = {}

local function applyNoclip()
    if not NoclipEnabled or MenuUnloaded then return end
    local character = LocalPlayer and LocalPlayer.Character
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if NoclipSavedCollision[part] == nil then
                NoclipSavedCollision[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

local function restoreNoclipCollision()
    for part, originalState in pairs(NoclipSavedCollision) do
        if part and part.Parent and part:IsA("BasePart") then
            pcall(function() part.CanCollide = originalState end)
        end
    end
    table.clear(NoclipSavedCollision)
end

local function setNoclip(enabled)
    NoclipEnabled = enabled == true

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if not NoclipEnabled then
        restoreNoclipCollision()
        return
    end

    applyNoclip()

    NoclipConnection = RunService.Heartbeat:Connect(function()
        if MenuUnloaded or not NoclipEnabled then return end
        applyNoclip()
    end)
end

