local Running = false
local Closing = false

local function Start()

	if Running then
		return
	end

	Running = true

	Title.Text = "Loading..."

	local CircleTween = TweenService:Create(
		Logo,

		TweenInfo.new(
			0.7,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.InOut
		),

		{
			Position = UDim2.new(
				0,
				66,
				0.5,
				0
			)
		}
	)

	CircleTween:Play()

	CircleTween.Completed:Wait()

	Title.Text = "Starting..."

	task.wait(0.3)

	Percentage.TextTransparency = 0

	local Progress = 0

	while Progress < 100 do

		Progress += math.random(5, 11)

		if Progress > 100 then
			Progress = 100
		end

		Percentage.Text =
			tostring(Progress) .. "%"

		local FillWidthScale =
			Progress / 100

		local FillWidthOffset =
			-FILL_START_OFFSET * FillWidthScale

		TweenService:Create(
			Fill,

			TweenInfo.new(
				0.12,
				Enum.EasingStyle.Linear
			),

			{
				Size = UDim2.new(
					FillWidthScale,
					FillWidthOffset,
					1,
					0
				)
			}
		):Play()

		task.wait(0.12)
	end

	Fill.Size = UDim2.new(
		1,
		-FILL_START_OFFSET,
		1,
		0
	)

	Percentage.Text = "100%"

	task.wait(0.5)

	Title.Visible = false
	Stage.Visible = false
	Footer.Visible = false

	Success.Visible = true

	SuccessCircleStroke.Transparency = 1
	SuccessInfinity.TextTransparency = 1
	SuccessText.TextTransparency = 1

	CloseButton.TextTransparency = 1
	CloseStroke.Transparency = 1

	local SuccessFade = TweenInfo.new(
		0.5,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	TweenService:Create(
		SuccessCircleStroke,
		SuccessFade,
		{
			Transparency = 0.94
		}
	):Play()

	TweenService:Create(
		SuccessInfinity,
		SuccessFade,
		{
			TextTransparency = 0.94
		}
	):Play()

	TweenService:Create(
		SuccessText,
		SuccessFade,
		{
			TextTransparency = 0
		}
	):Play()

	TweenService:Create(
		CloseButton,
		SuccessFade,
		{
			TextTransparency = 0
		}
	):Play()

	TweenService:Create(
		CloseStroke,
		SuccessFade,
		{
			Transparency = 0
		}
	):Play()

end

local function Close()

	if Closing then
		return
	end

	if not Gui or not Gui.Parent then
		return
	end

	Closing = true

	CloseButton.Active = false

	local FadeInfo = TweenInfo.new(
		0.4,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.InOut
	)

	TweenService:Create(
		Card,
		FadeInfo,
		{
			BackgroundTransparency = 1
		}
	):Play()

	TweenService:Create(
		SuccessCircleStroke,
		FadeInfo,
		{
			Transparency = 1
		}
	):Play()

	TweenService:Create(
		SuccessInfinity,
		FadeInfo,
		{
			TextTransparency = 1
		}
	):Play()

	TweenService:Create(
		SuccessText,
		FadeInfo,
		{
			TextTransparency = 1
		}
	):Play()

	TweenService:Create(
		CloseButton,
		FadeInfo,
		{
			TextTransparency = 1
		}
	):Play()

	TweenService:Create(
		CloseStroke,
		FadeInfo,
		{
			Transparency = 1
		}
	):Play()

	task.wait(0.42)

	Gui:Destroy()

	local handoff = _G.__ToolboxSplashFinished
	if handoff then
		handoff:Fire()
	end

end

