local function createSlider(name, minVal, maxVal, initialVal, step, callback)
    step = step or 1 
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 60)
    frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    applyCorner(frame)

    local current = initialVal or minVal
    local title = Instance.new("TextLabel", frame)
    title.Text = name
    title.Size = UDim2.new(0.7, 0, 0.3, 0)
    title.Position = UDim2.new(0.05, 0, 0.1, 0)
    title.BackgroundTransparency = 1
    title.TextColor3 = WHITE
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextSize = 16
    title.Font = mainFont

    local valLab = Instance.new("TextLabel", frame)
    valLab.Text = tostring(current)
    valLab.Size = UDim2.new(0.2, 0, 0.3, 0)
    valLab.Position = UDim2.new(0.95, 0, 0.1, 0)
    valLab.AnchorPoint = Vector2.new(1, 0)
    valLab.BackgroundTransparency = 1
    valLab.TextColor3 = WHITE
    valLab.TextXAlignment = Enum.TextXAlignment.Right
    valLab.TextSize = 16
    valLab.Font = mainFont

    local track = Instance.new("Frame", frame)
    track.Name = "SliderTrack"
    track.Size = UDim2.new(0.9, 0, 0, 4)
    track.Position = UDim2.new(0.5, 0, 0.65, 0)
    track.AnchorPoint = Vector2.new(0.5, 0.5)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(0,0,1,0)
    fill.Position = UDim2.new(0, 0, 0.5, 0)
    fill.AnchorPoint = Vector2.new(0, 0.5)
    fill.BackgroundColor3 = SELECTED_COLOR
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    RegisterRGB(fill, "Background") 

    local knob = Instance.new("TextButton", track)
    knob.Name = "SliderKnob"
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.BackgroundColor3 = WHITE
    knob.ZIndex = 5
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Text = ""

    local hitbox = Instance.new("TextButton", frame)
    hitbox.Name = "SliderHitbox"
    hitbox.Size = UDim2.new(0.9, 0, 0, 40) 
    hitbox.Position = UDim2.new(0.5, 0, 0.65, 0)
    hitbox.AnchorPoint = Vector2.new(0.5, 0.5)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = 10 
    hitbox.Active = true
    knob.Active = true

    local function applyValue(newValue)
        local rawValue = math.clamp(newValue, minVal, maxVal)
        current = math.floor(rawValue / step + 0.5) * step
        current = math.clamp(current, minVal, maxVal)
        local denom = (maxVal - minVal)
        local finalPct = denom == 0 and 0 or ((current - minVal) / denom)

        fill.Size = UDim2.new(finalPct, 0, 1, 0)
        knob.Position = UDim2.new(finalPct, 0, 0.5, 0)
        valLab.Text = tostring(current)
        if callback then callback(current) end
    end

    local function update(input)
        local sizeX = track.AbsoluteSize.X
        if sizeX == 0 then return end
        local pos = input.Position.X - track.AbsolutePosition.X
        local pct = math.clamp(pos / sizeX, 0, 1)
        local raw = minVal + (maxVal - minVal) * pct
        applyValue(raw)
    end

    local iP = ((maxVal - minVal) == 0) and 0 or ((current - minVal) / (maxVal - minVal))
    fill.Size = UDim2.new(iP, 0, 1, 0)
    knob.Position = UDim2.new(iP, 0, 0.5, 0)

    local function beginSlide(updateFn, input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSlider = { Update = updateFn }
            updateFn(input)
        end
    end

    hitbox.InputBegan:Connect(function(i) 
        beginSlide(update, i)
    end)

    knob.InputBegan:Connect(function(i)
        beginSlide(update, i)
    end)

    _G.PortraitControllers[frame] = {
        bindClone = function(clone)
            local cloneHitbox = clone:FindFirstChild("SliderHitbox", true)
            local cloneTrack = clone:FindFirstChild("SliderTrack", true)
            local function cloneUpdate(input)
                local t = cloneTrack
                if not t or t.AbsoluteSize.X == 0 then return end
                local pos = input.Position.X - t.AbsolutePosition.X
                local pct = math.clamp(pos / t.AbsoluteSize.X, 0, 1)
                local raw = minVal + (maxVal - minVal) * pct
                applyValue(raw)
            end
            if cloneHitbox then
                cloneHitbox.Active = true
                cloneHitbox.InputBegan:Connect(function(i)
                    beginSlide(cloneUpdate, i)
                end)
            end
            local cloneKnob = clone:FindFirstChild("SliderKnob", true)
            if cloneKnob then
                cloneKnob.Active = true
                cloneKnob.InputBegan:Connect(function(i)
                    beginSlide(cloneUpdate, i)
                end)
            end
        end
    }

    return frame
end

local function createSelect(name, options, isMultiSelect, settingsContainer, getIsOpen, settingsIndicator)
    local OPTION_HEIGHT = 35
    local PADDING = 5
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundTransparency = 1
    frame.ClipsDescendants = true
    frame.AutomaticSize = Enum.AutomaticSize.Y 
