    if P_CatScroll.CanvasPosition.Y ~= 0 or P_CatScroll.CanvasPosition.X < 0 or P_CatScroll.CanvasPosition.X > maxX then
        P_CatScroll.CanvasPosition = Vector2.new(math.clamp(P_CatScroll.CanvasPosition.X, 0, maxX), 0)
