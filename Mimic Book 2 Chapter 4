local RunningFeatures = {}

local function compileAndRun(code, label, key, async)
    if type(code) ~= "string" or code:gsub("%s", "") == "" then
        return false
    end

    key = key or label
    if RunningFeatures[key] then
        return false
    end

    local compiler = loadstring or load
    if not compiler then
        return false
    end

    local fn, err = compiler(code)
    if not fn then
        return false
    end

    RunningFeatures[key] = true

    local function execute()
        local ok, execErr = pcall(fn)
        RunningFeatures[key] = nil
        if not ok then
        end
    end

    if async then
        task.spawn(execute)
    else
        execute()
    end

    return true
end

local function BuildCategoryFromData(data)
    local catObj = Toolbox:Category(data.name)

    local function addItem(parentApi, item)
        if item.type == "action" then
            local runAction = function()
                if MenuUnloaded then return end
                if item.label == "Unload Menu" then
                    unloadMenu()
                    return
                end
                local code = item.action_code or item.function_code
                if (not code or code:gsub("%s", "") == "") and parentApi._fallbackCode then
                    code = parentApi._fallbackCode
                end
                compileAndRun(code, item.label, item.path, item.label == "Auto Quick Time")
            end

            if item.label == "Auto Quick Time" then
                parentApi:OneTimeButton(item.label, runAction)
            else
                parentApi:TextButton(item.label, runAction)
            end

            if item.has_shortcut then
                _G.ModuleRegistry[item.path] = {
                    toggleFunc = function()
                        compileAndRun(item.action_code or item.function_code, item.label, item.path, item.label == "Auto Quick Time")
                    end,
                    isOn = false,
                    updateShortcut = function() end,
                    label = item.label,
                    icon = item.icon or data.icon or "rbxassetid://0",
                    isAction = true
                }
            end

        elseif item.type == "toggle" then
            local modApi, toggleFunc = parentApi:ModuleSettingDropdown(item.label, item.enabled == true, function(isOn)
                if MenuUnloaded then return end

                if item.label == "Fullbright + NoFog" then
                    setFullbright(isOn)
                elseif item.label == "Noclip" then
                    setNoclip(isOn)
                elseif isOn then
                    compileAndRun(item.action_code or item.function_code, item.label, item.path)
                end

                local reg = _G.ModuleRegistry[item.path]
                if reg then
                    reg.isOn = isOn
                    reg.updateShortcut(isOn)
                end
            end)

            if item.has_shortcut then
                _G.ModuleRegistry[item.path] = {
                    api = modApi,
                    toggleFunc = toggleFunc,
                    isOn = item.enabled == true,
                    updateShortcut = function() end,
                    label = item.label,
                    icon = item.icon or data.icon or "rbxassetid://0",
                    isAction = false
                }
            end

            if item.items then
                for _, sub in ipairs(item.items) do
                    if sub.type == "slider" then
                        local min = sub.range and sub.range[1] or 0
                        local max = sub.range and sub.range[2] or 100
                        modApi:Slider(sub.label, min, max, sub.value or min, sub.step or 1, function() end)
                    elseif sub.type == "toggle" then
                        modApi:Toggle(sub.label, sub.enabled == true, function(v)
                            if v then compileAndRun(sub.action_code or sub.function_code, sub.label) end
                        end)
                    elseif sub.type == "checkbox" then
                        modApi:Checkbox(sub.label, sub.enabled == true, function(v)
                            if v then compileAndRun(sub.action_code or sub.function_code, sub.label) end
                        end)
                    elseif sub.type == "select" then
                        modApi:Select(sub.label, sub.options or {})
                    elseif sub.type == "multiselect" then
                        modApi:MultiSelect(sub.label, sub.options or {})
                    elseif sub.type == "action" then
                        modApi:TextButton(sub.label, function()
                            compileAndRun(sub.action_code or sub.function_code, sub.label)
                        end)
                    end
                end
            end

        elseif item.type == "divider" then
            local divApi = parentApi:Divider(item.label)
            divApi._fallbackCode = item.function_code
            if item.items then
                for _, sub in ipairs(item.items) do
                    addItem(divApi, sub)
                end
            end

        elseif item.type == "player_list" then
            local divApi = parentApi:Divider(item.label)
            local getPlayers = function()
                local names = {}
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LocalPlayer then
                        table.insert(names, pl.Name)
                    end
                end
                return names
            end
            local _, updateDropdown, getSelectedTarget = divApi:Select("Target Player", getPlayers())
            local refreshQueued = false
            local function refreshTeleportTargets()
                if refreshQueued then return end
                refreshQueued = true
                task.defer(function()
                    refreshQueued = false
                    updateDropdown(getPlayers())
                end)
            end
            Players.PlayerAdded:Connect(refreshTeleportTargets)
            Players.PlayerRemoving:Connect(refreshTeleportTargets)
            refreshTeleportTargets()

            local function confirmTP()
                local targetName = getSelectedTarget and getSelectedTarget() or nil
                if not targetName or targetName == "None" or targetName == "" then return end
                local targetPlayer = Players:FindFirstChild(targetName)
                local myCharacter = LocalPlayer and LocalPlayer.Character
                local targetCharacter = targetPlayer and targetPlayer.Character
                local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                if myRoot and targetRoot then
                    myCharacter:PivotTo(targetRoot.CFrame + Vector3.new(0, 3, 0))
                end
            end
            divApi:TextButton("Confirm Teleport", confirmTP)
        end
    end

    for _, item in ipairs(data.items or {}) do
        addItem(catObj, item)
    end
    return catObj
end

