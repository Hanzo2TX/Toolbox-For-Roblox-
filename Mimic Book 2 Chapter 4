local isMin = false
local P_isMin = false

local CurrentOrientation = nil

local LandscapeElements = {}
local PortraitElements = {}

local function isPortrait()
    local vp = workspace.CurrentCamera.ViewportSize
    return vp.Y > vp.X
end

local Restore, P_Restore

local function applyOrientation()
    local portrait = isPortrait()
    local newOrientation = portrait and "portrait" or "landscape"
    if newOrientation == CurrentOrientation then return end
    CurrentOrientation = newOrientation

    if portrait then
        isMin = false
        if _G._LandscapeReset then _G._LandscapeReset() end
        if Restore then Restore.Visible = false end
    else
        P_isMin = false
        if _G._PortraitReset then _G._PortraitReset() end
        if P_Restore then P_Restore.Visible = false end
    end

    for _, elem in ipairs(LandscapeElements) do
        if elem and elem.Parent then elem.Visible = not portrait end
    end
    for _, elem in ipairs(PortraitElements) do
        if elem and elem.Parent then elem.Visible = portrait end
    end
end

