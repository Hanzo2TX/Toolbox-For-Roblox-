local function getTopbarObjects()
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local objects = {}

    pcall(function()
        local obj = Players.LocalPlayer.PlayerGui.Client.Popups.Settings.Topbar.Frame
        if obj then table.insert(objects, obj) end
    end)

    pcall(function()
        local obj = CoreGui.TopBarApp.TopBarApp.UnibarLeftFrame.UnibarMenu
        if obj then table.insert(objects, obj) end
    end)

    pcall(function()
        local obj = CoreGui.TopBarApp.TopBarApp.MenuIconHolder.TriggerPoint
        if obj then table.insert(objects, obj) end
    end)

    return objects
end

local function saveTopbarState()
    table.clear(TopbarObjects)

    for _, obj in ipairs(getTopbarObjects()) do
        table.insert(TopbarObjects, obj)

        if TopbarSavedState[obj] == nil then
            local state = {}

            pcall(function()
                state.VisibleProperty = obj.Visible
            end)

            pcall(function()
                state.VisibleAttribute = obj:GetAttribute("Visible")
            end)

            TopbarSavedState[obj] = state
        end
    end
end

local function setTopbarHidden(hidden)
    if hidden then
        saveTopbarState()
    end

    for _, obj in ipairs(TopbarObjects) do
        if obj and obj.Parent then
            if hidden then
                pcall(function() obj.Visible = false end)
                pcall(function() obj:SetAttribute("Visible", false) end)
            else
                local state = TopbarSavedState[obj]
                if state then
                    if state.VisibleProperty ~= nil then
                        pcall(function() obj.Visible = state.VisibleProperty end)
                    end

                    if state.VisibleAttribute ~= nil then
                        pcall(function() obj:SetAttribute("Visible", state.VisibleAttribute) end)
                    else
                        pcall(function() obj:SetAttribute("Visible", nil) end)
                    end
                else
                    pcall(function() obj.Visible = true end)
                    pcall(function() obj:SetAttribute("Visible", true) end)
                end
            end
        end
    end
end

local function restoreTopbar()
    local current = getTopbarObjects()
    for _, obj in ipairs(current) do
        if not TopbarSavedState[obj] then
            TopbarSavedState[obj] = {
                VisibleProperty = true,
                VisibleAttribute = true,
            }
        end
    end

    table.clear(TopbarObjects)
    for _, obj in ipairs(current) do
        table.insert(TopbarObjects, obj)
    end

    setTopbarHidden(false)
end

