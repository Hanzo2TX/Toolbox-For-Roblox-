local P_CategoryPages  = {}

local function P_selectCategory(index, skipLandscapeSync)
    local count = #P_CategoryPages
    if count == 0 or not P_CategoryPages[index] then return end

    if P_CategoryTabs[P_ActiveCatIndex] then
        local t = P_CategoryTabs[P_ActiveCatIndex]
        t.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        t.BackgroundTransparency = 0.6
        UnregisterRGB(t, "Background")
    end

    for i, page in ipairs(P_CategoryPages) do
        page.Visible = (i == index)
        if i == index then
            page.CanvasPosition = Vector2.new(0, page.CanvasPosition.Y)
        else
            page.CanvasPosition = Vector2.new(0, 0)
        end
    end

    P_ActiveCatIndex = index

    if not skipLandscapeSync and ActivateCategoryByIndex then
        ActivateCategoryByIndex(index, true)
    end

    if P_CategoryTabs[index] then
        local t = P_CategoryTabs[index]
        t.BackgroundColor3 = SELECTED_COLOR
        t.BackgroundTransparency = 0
        RegisterRGB(t, "Background")
    end
end

local function bindPortraitMirrorTree(source, clone)
    local watchedProps = {
        "Visible","Size","Position","BackgroundColor3","BackgroundTransparency","Text","TextColor3",
        "Image","ImageColor3","Rotation","CanvasSize","CanvasPosition","TextTransparency"
    }

    local function bindPair(srcObj, cloneObj)
        for _, prop in ipairs(watchedProps) do
            pcall(function()
                cloneObj[prop] = srcObj[prop]
                srcObj:GetPropertyChangedSignal(prop):Connect(function()
                    pcall(function()
                        cloneObj[prop] = srcObj[prop]
                    end)
                end)
            end)
        end

        local controller = _G.PortraitControllers[srcObj]
        if controller and controller.bindClone then
            controller.bindClone(cloneObj)
        end

        local srcChildren = srcObj:GetChildren()
        local cloneChildren = cloneObj:GetChildren()
        local maxCount = math.min(#srcChildren, #cloneChildren)
        for i = 1, maxCount do
            bindPair(srcChildren[i], cloneChildren[i])
        end
    end

    bindPair(source, clone)
end

local function BuildPortraitCategoryTabs()
    for _, tab in ipairs(P_CategoryTabs) do
        if tab then
            UnregisterRGB(tab, "Background")
            tab:Destroy()
        end
    end
    for _, page in ipairs(P_CategoryPages) do
        if page then
            page:Destroy()
        end
    end
    P_CategoryTabs = {}
    P_CategoryPages = {}
    P_ActiveCatIndex = 1
    P_ContentHolder.Position = UDim2.new(0, 0, 0, 0)
    P_ContentHolder.Size = UDim2.new(1, 0, 1, 0)

    if not Toolbox or not Toolbox.Categories then return end
    local count = #Toolbox.Categories
    if count == 0 then return end

    P_ContentHolder.Size = UDim2.new(1, 0, 1, 0)

    for i, cat in ipairs(Toolbox.Categories) do
        local tab = Instance.new("TextButton", P_CatScroll)
        tab.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        tab.BackgroundTransparency = 0.6
        tab.Size = UDim2.new(0, 70, 0.82, 0)
        tab.Text = cat.Name or ("Cat " .. i)
        tab.TextColor3 = WHITE
        tab.Font = mainFont
        tab.TextSize = 12
        tab.AutoButtonColor = false
        Instance.new("UICorner", tab).CornerRadius = UDim.new(0.3, 0)
        P_CategoryTabs[i] = tab

        local idx = i
        bindPress(tab, function()
            P_selectCategory(idx)
        end)

        local page = Instance.new("ScrollingFrame", P_ContentHolder)
        page.Name = "Portrait_Page_" .. i
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 0
        page.ScrollingDirection = Enum.ScrollingDirection.Y
        page.AutomaticCanvasSize = Enum.AutomaticSize.None
        page.ClipsDescendants = true
        page.Size = UDim2.new(1, 0, 1, 0)
        page.Position = UDim2.new(0, 0, 0, 0)
        page.Visible = false
        page.ScrollingEnabled = true
        page.ElasticBehavior = Enum.ElasticBehavior.Never

        local pageLayout = Instance.new("UIListLayout", page)
        pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Padding = UDim.new(0, 5)
        local pagePad = Instance.new("UIPadding", page)
        pagePad.PaddingTop    = UDim.new(0, 4)
        pagePad.PaddingBottom = UDim.new(0, 4)
        pagePad.PaddingLeft   = UDim.new(0, 4)
        pagePad.PaddingRight  = UDim.new(0, 4)

        for _, elem in ipairs(cat.Elements or {}) do
            if elem then
                local clone = elem:Clone()
                clone.Parent = page
                clone.Visible = true
                bindPortraitMirrorTree(elem, clone)
            end
        end

        P_CategoryPages[i] = page

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            page.CanvasSize = UDim2.new(0, 0, 0, h)
            page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
        end)
        page:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            page.CanvasSize = UDim2.new(0, 0, 0, h)
            page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
        end)
        page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            local h = pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset
            local maxY = math.max(0, h - page.AbsoluteWindowSize.Y)
            if page.CanvasPosition.X ~= 0 or page.CanvasPosition.Y < 0 or page.CanvasPosition.Y > maxY then
                page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maxY))
            end
        end)
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + pagePad.PaddingTop.Offset + pagePad.PaddingBottom.Offset)
    end

    updatePortraitCatScroll()
    P_selectCategory(1)
end

