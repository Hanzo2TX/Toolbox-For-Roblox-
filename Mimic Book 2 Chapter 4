    head.Name = "HeaderBar"
    head.Size = UDim2.new(1, 0, 0, 40)
    head.BackgroundColor3 = Color3.fromRGB(0,0,0)
    head.Text = ""
    head.AutoButtonColor = false
    head.LayoutOrder = 1
    applyStyleStroke(head)

    local ind = Instance.new("Frame", head)
    ind.BackgroundColor3 = WHITE
    ind.BackgroundTransparency = 1
    ind.Size = UDim2.new(0, 2, 0.8, 0)
    ind.Position = UDim2.new(0, 4, 0.1, 0)
    ind.AnchorPoint = Vector2.new(0, 0)
    Instance.new("UICorner", ind).CornerRadius = UDim.new(0.2,0)
    RegisterRGB(ind, "Background", WHITE) 

    local title = Instance.new("TextLabel", head)
    title.Text = name
    title.Size = UDim2.new(1, -15, 1, 0)
    title.Position = UDim2.new(0, 15, 0, 0)
    title.BackgroundTransparency = 1
    title.TextColor3 = WHITE
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = mainFont
    title.TextSize = 18

    local sett = Instance.new("Frame", frame)
    sett.Name="SettingsContainer"
    sett.Size = UDim2.new(1, 0, 0, 0)
    sett.ClipsDescendants = true
    sett.LayoutOrder = 2
    sett.BackgroundTransparency = 1
    local list2 = Instance.new("UIListLayout", sett)
    list2.SortOrder = Enum.SortOrder.LayoutOrder
    list2.Padding = UDim.new(0, 5)
    local sp = Instance.new("UIPadding", sett)
    sp.PaddingTop=UDim.new(0,5)
    sp.PaddingBottom=UDim.new(0,5)
    sp.PaddingLeft=UDim.new(0.05,0)
    sp.PaddingRight=UDim.new(0,0)

    local open = false
    local hasI = false
    local isT = init or false
    local setToggleState = function() end

    if toggle then
        local tr = Instance.new("TextButton", head)
        tr.Name = "ToggleTrack"
        tr.Size = UDim2.new(0, 50, 0, 24)
        tr.Position = UDim2.new(1, 0, 0.5, 0)
        tr.AnchorPoint = Vector2.new(1, 0.5)
        tr.Text = ""
        tr.AutoButtonColor = false
        Instance.new("UICorner", tr).CornerRadius = UDim.new(1,0)
        local kn = Instance.new("Frame", tr)
        kn.Size = UDim2.new(0, 18, 0, 18)
        kn.AnchorPoint = Vector2.new(0.5, 0.5)
        kn.BackgroundColor3 = WHITE
        Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)

        setToggleState = function(newState)
            isT = newState and true or false
            frame:SetAttribute("ModuleToggleState", isT)
            local c, p
            if isT then 
                c = SELECTED_COLOR
                p = UDim2.new(1, -12, 0.5, 0)
                RegisterRGB(tr, "Background")
            else 
                c = Color3.fromRGB(120, 120, 120)
                p = UDim2.new(0, 12, 0.5, 0)
                UnregisterRGB(tr, "Background") 
            end
            TweenService:Create(tr, TweenInfo.new(getAnimSpeed()), {BackgroundColor3 = c}):Play()
            TweenService:Create(kn, TweenInfo.new(getAnimSpeed()), {Position = p}):Play()
            if toggleCallback then toggleCallback(isT) end
        end

        setToggleState(isT)

        bindPress(tr, function()
             setToggleState(not isT)
        end)
    end

    local function setOpen(newOpen)
        if not hasI then return end
        open = newOpen and true or false
        frame:SetAttribute("ModuleOpen", open)
        local h = open and (list2.AbsoluteContentSize.Y + 10) or 0
        local ih = open and (40 + h - 10) or 0
        TweenService:Create(ind, TweenInfo.new(getAnimSpeed()), {Size = UDim2.new(0, 2, 0, ih), BackgroundTransparency = open and 0 or 1}):Play()
        TweenService:Create(sett, TweenInfo.new(getAnimSpeed()), {Size = UDim2.new(1, 0, 0, h)}):Play()
    end

    bindPress(head, function()
        if not hasI then return end
        setOpen(not open)
    end)

    local api = {}
    local function mark()
        if not hasI then
            hasI = true
            frame:SetAttribute("HasSettings", true)
        end
    end
    function api:Slider(n, min, max, i, s) mark(); createSlider(n, min, max, i, s).Parent = sett; return api end

    function api:Select(n, o) 
        mark() 
        local f, updateFunc, getValue = createSelect(n, o, false, sett, function() return open end, ind)
        f.Parent = sett
        return api, updateFunc, getValue 
    end

    function api:MultiSelect(n, o) 
        mark() 
        local f, updateFunc, getValue = createSelect(n, o, true, sett, function() return open end, ind)
        f.Parent = sett
        return api, updateFunc, getValue
    end

    function api:Toggle(n, def, c) 
        mark() 
        createSlidingToggle(n, def, c).Parent = sett 
        return api 
    end

    function api:Checkbox(n, def, c) 
        mark() 
        createCheckbox(n, def, c).Parent = sett 
        return api 
    end

    function api:TextButton(n, c) mark(); createTextButton(n, c).Parent = sett; return api end
    function api:OneTimeButton(n, c) mark(); createOneTimeButton(n, c).Parent = sett; return api end

    _G.PortraitControllers[frame] = {
        bindClone = function(clone)
            local cloneHead = clone:FindFirstChild("HeaderBar", true)
            local cloneToggle = cloneHead and cloneHead:FindFirstChild("ToggleTrack")
            if cloneHead then
                bindPress(cloneHead, function()
                    if hasI then setOpen(not open) end
                end)
                cloneHead.Active = true
            end
            if cloneToggle then
                bindPress(cloneToggle, function()
                    setToggleState(not isT)
                end)
            end
        end
    }

    return frame, api, setToggleState
end

