	Main = MainPlate.Position,
	Link = LinkPlate.Position,
	Cat = CatListPlate.Position,
	Mod = ModulePlate.Position,
	Logo = LogoPlate.Position,
	Min = MinPlate.Position
}

_G._LandscapeReset = function()
    MainPlate.Position = PosCache.Main
    LinkPlate.Position = PosCache.Link
    CatListPlate.Position = PosCache.Cat
    ModulePlate.Position = PosCache.Mod
    LogoPlate.Position = PosCache.Logo
    MinPlate.Position = PosCache.Min
end

local function createSlideTween(instance, originalPos, isClosing)
    local targetX
    if isClosing then
        targetX = -1
    else
        targetX = originalPos.X.Scale
    end
    
    local duration = getAnimSpeed()
    local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    return TweenService:Create(instance, info, {Position = UDim2.new(targetX, 0, originalPos.Y.Scale, 0)})
end

MinButton.MouseButton1Click:Connect(function()
    if isMin then return end
    isMin = true
    _G.__ToolboxMinimized = true
    setTopbarHidden(false)
    
    createSlideTween(MainPlate, PosCache.Main, true):Play()
    createSlideTween(LinkPlate, PosCache.Link, true):Play()
    createSlideTween(CatListPlate, PosCache.Cat, true):Play()
    createSlideTween(ModulePlate, PosCache.Mod, true):Play()
    createSlideTween(LogoPlate, PosCache.Logo, true):Play()
    createSlideTween(MinPlate, PosCache.Min, true):Play()

    local delayTime = getAnimSpeed() > 0 and getAnimSpeed() or 0
    task.delay(delayTime, function() Restore.Visible = true end)
end)

Restore.MouseButton1Click:Connect(function()
    if not isMin then return end
    isMin = false
    _G.__ToolboxMinimized = false
    setTopbarHidden(true)
    Restore.Visible = false
    
    createSlideTween(MainPlate, PosCache.Main, false):Play()
    createSlideTween(LinkPlate, PosCache.Link, false):Play()
    createSlideTween(CatListPlate, PosCache.Cat, false):Play()
    createSlideTween(ModulePlate, PosCache.Mod, false):Play()
    createSlideTween(LogoPlate, PosCache.Logo, false):Play()
    createSlideTween(MinPlate, PosCache.Min, false):Play()
end)

local d, sPos, dStart
Restore.InputBegan:Connect(function(i) 
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
		d = true; sPos = Restore.Position; dStart = i.Position 
	end 
end)
UserInputService.InputChanged:Connect(function(i) 
	if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then 
		local delta = i.Position - dStart
		Restore.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + delta.X, sPos.Y.Scale, sPos.Y.Offset + delta.Y) 
	end 
end)
UserInputService.InputEnded:Connect(function(i) 
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
		d = false 
	end 
end)

